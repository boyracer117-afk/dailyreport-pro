{
  "name": "DailyReport",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "description": "Day of the week"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Work date"
    },
    "truck_registration": {
      "type": "string",
      "description": "Truck registration number"
    },
    "trailer_1_registration": {
      "type": "string",
      "description": "Trailer 1 registration number"
    },
    "trailer_2_registration": {
      "type": "string",
      "description": "Trailer 2 registration number"
    },
    "start_km": {
      "type": "number",
      "description": "Starting odometer reading (km)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "finish_km": {
      "type": "number",
      "description": "Finishing odometer reading (km)"
    },
    "finish_time": {
      "type": "string",
      "description": "Finish time (HH:MM)"
    },
    "total_km": {
      "type": "number",
      "description": "Total kilometres travelled (calculated)"
    },
    "fatigue_option": {
      "type": "string",
      "enum": [
        "Standard Hours",
        "BFM (Basic Fatigue Management)"
      ],
      "description": "Fatigue management option"
    },
    "fatigue_driver_type": {
      "type": "string",
      "enum": [
        "Solo",
        "Two-up"
      ],
      "description": "Driver type for fatigue management"
    },
    "fatigue_rest_breaks": {
      "type": "string",
      "description": "Rest breaks taken during shift"
    },
    "fatigue_declared": {
      "type": "boolean",
      "description": "Driver fatigue declaration confirmed"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "date",
    "truck_registration"
  ]
}